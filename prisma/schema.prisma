// Prisma schema for Weekly Sales Velocity & Revenue Growth Analytics Dashboard

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id             String         @id @default(cuid())
  email          String         @unique
  passwordHash   String
  businessName   String         @default("Acme Analytics Corp")
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  sales          Sale[]
  weeklyMetrics  WeeklyMetric[]
  csvImports     CsvImport[]

  @@map("users")
}

model CsvImport {
  id         String   @id @default(cuid())
  userId     String
  filename   String
  rowCount   Int
  importedAt DateTime @default(now())

  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  sales      Sale[]

  @@index([userId, importedAt])
  @@map("csv_imports")
}

model Sale {
  id           String     @id @default(cuid())
  userId       String
  importId     String?
  amount       Float
  currency     String     @default("USD")
  category     String     // e.g., Enterprise, SaaS Pro, Consulting, Add-ons
  customerName String?
  orderRef     String?
  notes        String?
  soldAt       DateTime
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  csvImport    CsvImport? @relation(fields: [importId], references: [id], onDelete: SetNull)

  @@index([userId, soldAt])
  @@index([importId])
  @@index([category])
  @@map("sales")
}

model WeeklyMetric {
  id            String    @id @default(cuid())
  userId        String
  weekStartDate DateTime
  weekEndDate   DateTime
  weekNumber    Int
  year          Int
  totalRevenue  Float
  totalUnits    Int
  aov           Float
  velocityPct   Float     // ((this_week - last_week) / last_week) * 100
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, year, weekNumber])
  @@index([userId, weekStartDate])
  @@map("weekly_metrics")
}

